# ローカルのモック開発で使用する。未指定時も開発環境だけはmockになる。
VITE_API_MODE=mock

# Supabase接続時に設定する。
# 本番環境ではVITE_API_MODE=supabaseが必須で、mockは起動時に拒否される。
# VITE_API_MODE=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service Role Key、Google OAuth secret、Google access/refresh tokenは
# VITE_*へ設定しない。ブラウザへ公開されないSupabase Secretsで管理する。
