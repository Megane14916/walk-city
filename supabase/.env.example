# Use a dedicated OAuth client for Google Health (separate from login OAuth).
GOOGLE_HEALTH_CLIENT_ID=your-health-oauth-client.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=replace-with-a-secret
GOOGLE_HEALTH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/google-health-callback
HEALTH_OAUTH_SUCCESS_URL=https://your-frontend.example/health/connect

# Generate an independent, high-entropy value of at least 32 characters.
HEALTH_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
